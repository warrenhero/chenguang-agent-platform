# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密码

# ===== 应用 =====
APP_NAME=MyApp
APP_ENV=development
APP_DEBUG=true

# ===== MySQL =====
# 应用与 docker compose 共用 DB_PASSWORD，避免两处维护导致不一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=chenguang

# ===== Redis =====
REDIS_PASSWORD=change-me

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ===== 日志 =====
LOG_LEVEL=DEBUG
LOG_DIR=logs
