# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密码

# ===== 应用 =====
APP_NAME=MyApp
APP_ENV=development
APP_DEBUG=true

# ===== MySQL =====
# 应用与 docker compose 共用 DB_PASSWORD，避免两处维护导致不一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=chenguang

# ===== Redis =====
REDIS_PASSWORD=change-me

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ===== 日志 =====
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ===== JWT配置 =====
# 生成密钥：openssl rand -hex 32（或 python -c "import secrets;print(secrets.token_hex(32))"）
# 每个环境使用不同密钥；此处仅为占位，需替换为真实随机值
JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== RBAC 初始管理员 =====
# 首次启动时创建/提升为超级管理员；留空则不创建（全新环境将无人能管理后台）
# 创建成功后请移除密码并重启
# BOOTSTRAP_SUPERUSER_USERNAME=admin
# BOOTSTRAP_SUPERUSER_PASSWORD=
# BOOTSTRAP_SUPERUSER_EMAIL=admin@example.com
